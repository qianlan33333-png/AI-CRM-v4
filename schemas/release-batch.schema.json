{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qianlan33333-png/AI-CRM-v4/schemas/release-batch.schema.json",
  "type": "object",
  "required": [
    "batch_id",
    "candidate_id",
    "worktree",
    "base_main_sha",
    "aggregate_head_sha",
    "merge_preview_sha",
    "candidate_tree_sha",
    "package_sha256",
    "members"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "worktree": {
      "type": "string",
      "minLength": 1
    },
    "base_main_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "aggregate_head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "merge_preview_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_tree_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project_key",
          "work_item",
          "origin_thread_id",
          "commit_sha",
          "tree_sha",
          "receipt_ref",
          "receipt_sha256"
        ],
        "properties": {
          "project_key": {
            "type": "string",
            "minLength": 1
          },
          "work_item": {
            "type": "string",
            "minLength": 1
          },
          "origin_thread_id": {
            "type": "string",
            "minLength": 1
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "tree_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "receipt_ref": {
            "type": "string",
            "minLength": 1
          },
          "receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
