{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qianlan33333-png/AI-CRM-v4/schemas/main-freshness-attestation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "visibility",
    "branch",
    "stage",
    "main_sha",
    "main_tree",
    "pr_head_sha",
    "pr_head_tree",
    "merge_preview_sha",
    "candidate_tree_sha",
    "bundle_sha256",
    "package_sha256",
    "queried_at",
    "issued_at",
    "expires_at",
    "nonce",
    "signing_identity"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "visibility": {
      "const": "public"
    },
    "branch": {
      "const": "main"
    },
    "stage": {
      "enum": [
        "source",
        "promotion"
      ]
    },
    "main_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "main_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "pr_head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "pr_head_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "merge_preview_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_tree_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "queried_at": {
      "type": "string",
      "format": "date-time"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "signing_identity": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "source"
          }
        }
      },
      "then": {
        "properties": {
          "package_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "promotion"
          }
        }
      },
      "then": {
        "properties": {
          "package_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
