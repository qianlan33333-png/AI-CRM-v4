{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["origin_thread_id", "candidate_id", "failure_class", "commit_sha", "tree_sha", "evidence", "required_action", "resubmit_conditions"],
  "properties": {
    "origin_thread_id": {"type": "string"},
    "candidate_id": {"type": "string"},
    "failure_class": {"enum": ["missing_evidence", "merge_conflict", "test_failure", "business_failure", "environment_blocked", "stale_candidate", "outcome_unknown"]},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "evidence": {"type": "array", "minItems": 1},
    "required_action": {"type": "string", "minLength": 1},
    "resubmit_conditions": {"type": "array", "minItems": 1}
  }
}
