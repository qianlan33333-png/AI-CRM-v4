[Unit]
Description=CRM v4 serial domestic release poller
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
UMask=0022
WorkingDirectory=/opt/aicrm/source
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=/opt/aicrm/toolchain/go-1.26.6/bin:/opt/aicrm/toolchain/node-v24.18.0-linux-x64/bin:/opt/aicrm/toolchain/npm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=GOCACHE=/opt/aicrm/cache/go-build
Environment=GOMODCACHE=/opt/aicrm/cache/go-mod
Environment=npm_config_cache=/opt/aicrm/cache/npm
Environment=TMPDIR=/opt/aicrm/domestic/tmp
ExecStart=/usr/bin/python3 /usr/local/libexec/aicrm/domestic_release.py --config /etc/aicrm/domestic-release.json poll
TimeoutStartSec=3h
PrivateTmp=true
